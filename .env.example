# Copy to .env and adjust if needed. Every value has a default in docker-compose.yml.
POSTGRES_USER=productfinder
POSTGRES_PASSWORD=productfinder
POSTGRES_DB=productfinder
POSTGRES_PORT=5432   # host port of the database (local development)
WEB_PORT=8080        # host port of the web app (full Docker stack)

# For running the API outside Docker, its DATABASE_URL lives in product-finder-api/.env.
