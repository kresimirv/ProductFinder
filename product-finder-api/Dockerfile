# Product Finder API: one image for three Compose services (migrate, seed, api).

# --- build: compile TypeScript (the Prisma client is generated by `npm ci`'s postinstall) ---
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci
COPY . .
RUN npm run build

# --- runtime: production dependencies + compiled code, running as a non-root user ---
FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
# Install scripts stay enabled: Prisma's postinstall fetches the migration engine for this platform.
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/main"]
